# Email (slanje PDF izveštaja preko Gmail SMTP-a).
# GMAIL_USER — gmail adresa naloga sa kog se šalje (npr. dositej.kartice@gmail.com)
# GMAIL_APP_PASSWORD — 16-cifreni App Password (Google Account → Security → App Passwords).
#   NIJE obična lozinka naloga! Zahteva uključen 2FA na nalogu.
# Bez ovih, dugme "Pošalji na email" vraća grešku ali ostatak sistema radi.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Opciono — ime pošiljaoca koje primalac vidi (default: naziv tenanta)
REPORT_EMAIL_FROM_NAME=""

# Tajna za Vercel cron endpoint (/api/cron/monthly-close). OBAVEZNO u produkciji
# - bez nje se mesecno zatvaranje nece pokretati. Vercel je salje kao
# 'Authorization: Bearer <CRON_SECRET>'.
CRON_SECRET=""
